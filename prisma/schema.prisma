generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PSYCHOLOGIST
  CLIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BlogPostStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

enum TicketCategory {
  TECHNICAL
  APPOINTMENT
  BILLING
  GENERAL
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  NORMAL
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  image        String?
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  psychologistProfile  PsychologistProfile?
  blogPosts            BlogPost[]
  appointmentsAsClient Appointment[] @relation("ClientAppointments")
  appointmentsAsPsych  Appointment[] @relation("PsychologistAppointments")
  accounts             Account[]
  sessions             Session[]
  tickets              Ticket[]
  ticketMessages       TicketMessage[] @relation("TicketMessageSender")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PsychologistProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?  @db.Text
  qualifications String?  @db.Text
  studies        String?  @db.Text
  specialties    String[]
  location       String?
  phone          String?
  websiteUrl     String?
  linkedinUrl    String?
  facebookUrl    String?
  instagramUrl   String?
  profileImageId String?

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImage Image? @relation(fields: [profileImageId], references: [id])

  availabilities       Availability[]
  psychologistServices PsychologistService[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  duration    Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments         Appointment[]
  psychologistServices PsychologistService[]
}

model PsychologistService {
  id             String   @id @default(cuid())
  psychologistId String
  serviceId      String
  customPrice    Decimal? @db.Decimal(10, 2)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  service      Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([psychologistId, serviceId])
}

model Availability {
  id             String  @id @default(cuid())
  psychologistId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  isActive       Boolean @default(true)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  psychologistId String
  serviceId      String?
  dateTime       DateTime
  endTime        DateTime
  status         AppointmentStatus @default(PENDING)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  client       User     @relation("ClientAppointments", fields: [clientId], references: [id])
  psychologist User     @relation("PsychologistAppointments", fields: [psychologistId], references: [id])
  service      Service? @relation(fields: [serviceId], references: [id])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String?   @db.Text
  authorId        String
  categoryId      String?
  status          BlogPostStatus @default(DRAFT)
  publishedAt     DateTime?
  featuredImageId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author        User          @relation(fields: [authorId], references: [id])
  category      BlogCategory? @relation(fields: [categoryId], references: [id])
  featuredImage Image?        @relation(fields: [featuredImageId], references: [id])
}

model BlogCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts BlogPost[]
}

model PageSection {
  id         String   @id @default(cuid())
  page       String
  sectionKey String
  title      String?
  subtitle   String?
  content    String?  @db.Text
  imageId    String?
  sortOrder  Int      @default(0)
  isVisible  Boolean  @default(true)
  metadata   Json?
  updatedAt  DateTime @updatedAt

  image Image? @relation(fields: [imageId], references: [id])

  @@unique([page, sectionKey])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  clientRole String?
  quote      String   @db.Text
  rating     Int      @default(5)
  avatarUrl  String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String    @db.Text
  isRead    Boolean   @default(false)
  repliedAt DateTime?
  replyBody String?   @db.Text
  createdAt DateTime  @default(now())
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  TicketCategory @default(GENERAL)
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation("TicketMessageSender", fields: [senderId], references: [id])
  body       String   @db.Text
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Image {
  id               String   @id @default(cuid())
  localPath        String
  originalUrl      String?
  unsplashId       String?
  photographerName String?
  photographerUrl  String?
  altText          String?
  createdAt        DateTime @default(now())

  pageSections         PageSection[]
  blogPosts            BlogPost[]
  psychologistProfiles PsychologistProfile[]
}
